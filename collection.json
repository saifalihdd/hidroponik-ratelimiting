              "path": ["klasifikasi"]
            },
            "description": "Klik Send lebih dari 5 kali dalam 1 menit untuk memicu Rate Limit. Request ke-6 akan mengembalikan 429 Too Many Requests.\n\nAlternatif: gunakan fitur Postman Runner / Collection Runner dengan 6 iterasi sekaligus."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Test ini dirancang untuk request ke-6 dst",
                  "// Jalankan request ini minimal 6 kali dalam 1 menit",
                  "const status = pm.response.status;",
                  "if (pm.response.code === 429) {",
                  "    pm.test('429 Too Many Requests – Rate limit aktif ✅', function () {",
                  "        pm.response.to.have.status(429);",
                  "    });",
                  "    pm.test('Pesan error rate limit ada', function () {",
                  "        const json = pm.response.json();",
                  "        pm.expect(json).to.have.property('error');",
                  "    });",
                  "} else {",
                  "    pm.test('Request masih dalam batas (200 OK)', function () {",
                  "        pm.response.to.have.status(200);",
                  "    });",
                  "    console.log('Request ke-' + pm.info.iteration + ' masih OK. Terus kirim hingga ke-6.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
